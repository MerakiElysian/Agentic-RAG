# Agentic RAG Environment Variables
# Add your API keys below. The app will automatically load them on startup.
# A Gemini key is required.

# Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Tavily Web Search API Key (https://app.tavily.com) - Optional for web retrieval
TAVILY_API_KEY=
